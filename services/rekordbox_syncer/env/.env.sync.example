# Copy this file to an ignored local profile, for example
# env/.env.sync.mac_to_drive, then replace every placeholder.
MASTER_MUSIC_FOLDER="/path/to/source/music"
SLAVE_MUSIC_FOLDER="/path/to/destination/music"
MASTER_XML_FOLDER="/path/to/source/rekordbox-xml"
SLAVE_XML_FOLDER="/path/to/destination/rekordbox-xml"
