{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "update dataset",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/apps/SongSmith/src/streaming/dataset.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--mode",
                "update"
            ]
        },
        {
            "name": "FilePilot Frontend",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "apps/FilePilot/src/welcome.py",
                "--server.port",
                "8080"
            ],
        },
        {
            "name": "SongSmith Frontend",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "apps/SongSmith/src/app.py",
                "--server.port",
                "8081"
            ]
        },
    ]
}