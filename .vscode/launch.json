{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "New Arrivals Playlist",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/spotify_discovery/src/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--config",
                "data/db/config_test.json",
                "--database",
                "data/db"
            ]
        },
        {
            "name": "Save Found on the Road playlist",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/spotify_downloader/src/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--config",
                "data/config_test.json",
                "--playlist-url",
                "https://open.spotify.com/playlist/2rtsszNSA7e5LlO87Ryfyx?si=6f8447d08331416d",
                "--output-folder",
                "./data/found_on_the_road"
            ]
        },
        {
            "name": "export rb tracknames excel",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/services/rekordbox_maintenance/src/export_tracknames_excel.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--database",
                "./data/rekordbox",
                "--output-folder",
                "./data/test"
            ]
        }
    ]
}